<?xml version="1.0" encoding="utf-8"?>
<!--
  The server is chosen by the user at runtime (any host: a NAS on the LAN, a Raspberry Pi,
  a VPS, a Tailscale name), and a network security config cannot list hosts that are only
  known at runtime. So cleartext is permitted here (OkHttp follows this file), and Settings
  warns when an http:// URL points at a host where the traffic would be readable on the wire
  (ARCHITECTURE.md D39, docs/APP.md §10). Prefer HTTPS: `tailscale serve` or a reverse proxy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
