# Magnetar crawl worker settings (docs/WORKERS.md §3). Keep this file private (chmod 600):
# it holds the worker token. Values below are the Raspberry Pi profile (router benchmark of
# 2026-10-26: the Pi's own conntrack table, 7680 entries, is its limit).

# The main server and this worker's token (one entry of the server's MAGNETAR_WORKER_TOKENS,
# the part after "rpi:").
MAGNETAR_WORKER_SERVER=https://<server>.<tailnet>.ts.net
MAGNETAR_WORKER_TOKEN=

# Seed checks
MAGNETAR_WORKER_LIVENESS=true
MAGNETAR_WORKER_LIVENESS_BATCH=300
MAGNETAR_LIVENESS_DHT_CONCURRENCY=16

# DHT crawler (UDP 6891-6894; forward them on the router only if you want more passive capture)
MAGNETAR_DHT=aggressive
MAGNETAR_DHT_PORT=6891
MAGNETAR_DHT_NODES=4
MAGNETAR_DHT_QPS=400
MAGNETAR_DHT_TCP_RATE=150
MAGNETAR_DHT_TCP_MAX=300
MAGNETAR_DHT_POOL=100000
MAGNETAR_DHT_FETCH_CONCURRENCY=32
MAGNETAR_DHT_METADATA_MAX=4194304
MAGNETAR_DHT_PROBE=1.1.1.1:443,9.9.9.9:443
MAGNETAR_DHT_UPNP=false

# Header probes (docs/PROBES.md, D117): off by default. On, they connect to torrent peers
# from this machine and download parts of files (README "Legal"); MAGNETAR_PROBE_UPLOAD=true
# also SHARES the verified pieces a probe holds. Pi profile (its router knee is ~3000
# packets/s out and the crawl already uses about two thirds of it; UNVERIFIED for probes).
MAGNETAR_PROBE=false
MAGNETAR_PROBE_UPLOAD=false
MAGNETAR_PROBE_PER_MIN=12
MAGNETAR_PROBE_PARALLEL=4
MAGNETAR_PROBE_PEERS=2
MAGNETAR_PROBE_MAX_BYTES=8388608
MAGNETAR_PROBE_WHOLE_PIECE_MAX=1048576

# Memory (905 MB machine): slow down above 200 MB RSS or below 250 MB available
MAGNETAR_WORKER_RSS_MAX_MB=200
MAGNETAR_WORKER_MIN_FREE_MB=250
MAGNETAR_WORKER_UPLOAD_BUFFER_MB=8

RUST_LOG=info
