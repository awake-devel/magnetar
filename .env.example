# Magnetar docker compose settings. Copy to .env next to compose.yml and edit.
# Every variable here is also passed to the magnetar container; docs/CONFIG.md lists them all.
# Values are read literally (no shell): no quotes needed, but avoid spaces.

# --- required -------------------------------------------------------------------------
# Postgres password for role magnetar. Hex keeps DATABASE_URL valid: openssl rand -hex 24
POSTGRES_PASSWORD=
# Bearer token for the API and /relay (the Android app's "API token"): openssl rand -hex 32
MAGNETAR_API_TOKEN=

# --- image and network ----------------------------------------------------------------
# Image tag of ghcr.io/awake-devel/magnetar (latest, or a release such as 0.1.0).
#MAGNETAR_VERSION=latest
# Host address:port for the API. Default 127.0.0.1:8787 (this machine only).
# 0.0.0.0:8787 opens it to the LAN: only on a trusted network (plain HTTP, token only).
#MAGNETAR_PUBLISH=127.0.0.1:8787

# --- storage --------------------------------------------------------------------------
# Where /data (downloads/ + state/) lives: a named volume by default, or a host folder.
#MAGNETAR_DATA=/srv/magnetar
# uid:gid the server runs as. With a host folder, use its owner (id -u / id -g).
#MAGNETAR_UID=10001
#MAGNETAR_GID=10001

# --- server ---------------------------------------------------------------------------
# Your npub: the root of the web of trust (can also be set from the app).
#MAGNETAR_ROOT_NPUB=npub1...
# Pause between crawl passes in seconds; 0 = continuous (fine on an always-on box).
#MAGNETAR_CRAWL_INTERVAL_SECS=900
#MAGNETAR_CRAWL_MAX_RELAYS=30
#MAGNETAR_CRAWL_EXPLORE_RELAYS=10
# NIP-66 relay discovery every 6 h (true/false).
#MAGNETAR_NIP66=true
# Torrent download engine (librqbit) in the server (true/false). Off = index and search only.
#MAGNETAR_DOWNLOADS=true
# sqlx pool size. Postgres' default max_connections is 100.
#MAGNETAR_DB_POOL=10
# Saved-search push notifications via ntfy. The topic is a secret: anyone who knows it reads it.
#MAGNETAR_NTFY_URL=https://ntfy.sh
#MAGNETAR_NTFY_TOPIC=magnetar-change-me
#RUST_LOG=info

# --- optional Tailscale sidecar (docker compose --profile tailscale up -d) ------------
# Auth key from https://login.tailscale.com/admin/settings/keys (reusable not needed).
#TS_AUTHKEY=tskey-auth-...
#TS_HOSTNAME=magnetar

# --- advanced -------------------------------------------------------------------------
# Use an existing Postgres instead of the db service (the db service still starts unless you
# also run `docker compose up -d magnetar --no-deps`).
#DATABASE_URL=postgres://magnetar:password@host:5432/magnetar
#POSTGRES_USER=magnetar
#POSTGRES_DB=magnetar
